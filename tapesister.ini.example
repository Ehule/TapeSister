; TapeSister portable configuration
[Paths]
SamplePath=
FastTrackerPath=
ExchangePath=
; Optional CDP runtime override. Select the folder containing the compatible
; curated CDP8 executables; each recipe names a missing component precisely.
; When blank, TapeSister checks cdp/bin beside the executable, then ./cdp/bin.
CdpBinPath=

[Startup]
; Install assets/tapesister_welcome.wav into bank 01 on a fresh launch.
startup_welcome_sample=1
; Audition the welcome tile once after the splash closes and audio is ready.
startup_welcome_autoplay=1

[Display]
; Dim applied to protected tiles: 0 leaves them unchanged, 90 is darkest.
locked_tile_dim_percent=38

[Waveform]
; Snap clicked playheads to the nearest zero crossing. Set to 0 for exact clicks.
playhead_zero_snap=1
; Zero-crossing candidates traversed by one Ctrl+Shift+wheel detent (1-20).
rotate_wheel_fine=5
; Zero-crossing candidates traversed by one Ctrl+wheel detent (20-100).
rotate_wheel_coarse=50
; Drone Maker internal-junction crossfade in milliseconds (1-1000, default 50).
drone_crossfade_ms=50
; Selection CHAIN stamp overlap in milliseconds (0-50, default 3).
; It is capped at one quarter of the current selection length.
chain_stamp_crossfade_ms=3
; Keep the canvas duration after Ripple Cut. Set to 1 for legacy crop/shrink.
ripple_cut_crop_canvas=0

[Audio]
; Blank uses the machine's default stereo playback device.
; Config can select SYSTEM DEFAULT or any SDL playback device.
audio_output_device=

[Audition]
; Per-voice note-on de-click ramp in milliseconds (0-20, default 2).
; Set to 0 to preserve the waveform's exact hard start.
voice_attack_ms=2

[MIDI]
; Blank automatically opens the first available MIDI input. Use OFF to disable
; MIDI, or select an exact device name in Config with the < and > controls.
midi_input_device=
; 0 = all channels (OMNI); 1-16 listens only to that MIDI channel.
midi_input_channel=0

[External Recording]
; Blank uses the machine's default recording device. Config can select
; SYSTEM DEFAULT or any SDL capture device without typing its name.
record_input_device=
; 0 = mix all channels to mono, 1 = first/left input, 2 = second/right input.
record_input_channel=1
; Threshold in dBFS. Lower values trigger on quieter sounds (-90 to 0).
record_threshold_db=-30
; Keep this much audio from before threshold crossing so attacks are not clipped.
record_preroll_ms=180
; Quiet time required before automatic stop logic considers the take finished.
record_silence_ms=650
; Extra quiet tape retained after silence detection for natural decays.
record_tail_ms=180
; Hard safety limit for a single recorded tile.
record_max_seconds=20

[Internal Capture]
; Resize the armed blank tile to the completed Capture duration. Set to 0 to
; retain the blank canvas duration used when Capture is armed.
capture_auto_resize=1
; Hard safety limit for an automatically resized Capture tile (1-600 seconds).
capture_max_seconds=20

[Sister Machine]
; Independent monitor levels. These do not change rolling input or Capture taps.
sister_dry_percent=100
sister_wet_percent=100
; Recording-head erase strength per complete buffer pass.
; 100 fully replaces the previous cell; 20 retains 80 percent as a ghost.
sister_erase_percent=100

[DSP Presets]
; SAVE/UPDATE in a DSP Transform writes four normalized macro positions.
; Rows 01-16 are DSP1 PROCESS; rows 17-32 are DSP2 PRIMITIVES.
; Missing rows keep the factory defaults. Example for DSP1 tile 06 (DUB):
; DspPreset06=0.30,0.75,0.55,0.45
; Example for DSP2 tile 05 (METAL, global seat 21; final value is SOURCE):
; DspPreset21=0.40,0.54,0.62,0.12

[CDP Presets]
; SAVE/UPDATE writes the four fixed musical positions, MIX, and variation seed.
; Recipes exposing fewer controls leave the unused positions at zero.
; Missing rows keep factory defaults. Example for CDP 2 tile 01 (global seat 17):
; CdpPreset17=8,8,3,0.28,1,1
