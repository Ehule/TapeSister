; TapeSister portable configuration
[Paths]
SamplePath=
FastTrackerPath=
ExchangePath=
; Optional CDP runtime override. Select the folder containing the compatible
; curated CDP8 executables; each recipe names a missing component precisely.
; When blank, TapeSister checks cdp/bin beside the executable, then ./cdp/bin.
CdpBinPath=

[Startup]
; Install assets/tapesister_welcome.wav into bank 01 on a fresh launch.
startup_welcome_sample=1
; Audition the welcome tile once after the splash closes and audio is ready.
startup_welcome_autoplay=1

[Waveform]
; Snap clicked playheads to the nearest zero crossing. Set to 0 for exact clicks.
playhead_zero_snap=1
; Zero-crossing candidates traversed by one Ctrl+Shift+wheel detent (1-20).
rotate_wheel_fine=5
; Zero-crossing candidates traversed by one Ctrl+wheel detent (20-100).
rotate_wheel_coarse=50
; Drone Maker internal-junction crossfade in milliseconds (1-1000, default 50).
drone_crossfade_ms=50

[DSP Presets]
; SAVE/UPDATE in a factory DSP Transform writes four normalized macro positions.
; Missing rows keep the factory defaults. Example for DSP tile 05 (DUB ECHO):
; DspPreset05=0.30,0.75,0.55,0.45

[CDP Presets]
; SAVE/UPDATE writes the four fixed musical positions, MIX, and variation seed.
; Recipes exposing fewer controls leave the unused positions at zero.
; Missing rows keep factory defaults. Example for CDP 2 tile 01 (global seat 17):
; CdpPreset17=8,8,3,0.28,1,1
