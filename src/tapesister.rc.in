#include <winver.h>

#define IDI_TAPESISTER_ICON 101

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "TapeSister Project\0"
      VALUE "FileDescription",  "TapeSister sample and tape performance instrument\0"
      VALUE "FileVersion",      "@PROJECT_VERSION@\0"
      VALUE "InternalName",     "TapeSister\0"
      VALUE "OriginalFilename", "TapeSister.exe\0"
      VALUE "ProductName",      "TapeSister\0"
      VALUE "ProductVersion",   "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

IDI_TAPESISTER_ICON ICON "@TAPESISTER_WINDOWS_ICON@"
