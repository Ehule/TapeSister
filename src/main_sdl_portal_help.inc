/* Non-destructive status-line help. Hit regions use native UI coordinates. */
static const char *portal_hover_help(const TsPortalUi *p,int x,int y,char *text,size_t size)
{
#define H(X,Y,W,H,T) if(x>=(X) && x<(X)+(W) && y>=(Y) && y<(Y)+(H))return (T)
    if(p->full_action) {
        H(192,217,118,22,"CREATE A NEW SAMPLE PAGE AND KEEP THIS RESULT THERE");
        H(330,217,118,22,"CANCEL NEW PAGE; KEEP THE SOURCE AND PREVIEW");
        return "";
    }
    if(p->macro_edit) {
        H(268,157,198,16,"NAME THIS PARAMETER IN MACROS VIEW; TAB MOVES BETWEEN FIELDS");
        H(268,182,198,16,"MACRO MINIMUM; FULL VIEW KEEPS THE ORIGINAL CDP RANGE");
        H(268,207,198,16,"MACRO MAXIMUM; CHANGING THE RANGE DOES NOT CHANGE THE CURRENT VALUE");
        H(178,250,90,22,"ACCEPT THE MACRO NAME AND RANGE; SAVE THE RECIPE TO KEEP THEM");
        H(277,250,90,22,"RESTORE THE ORIGINAL PARAMETER NAME AND RANGE; KEEP ITS VALUE");
        H(376,250,90,22,"DISCARD MACRO NAME AND RANGE EDITS");
        return "";
    }
    if(p->manage_open) {
        H(472,62,70,16,"CLOSE THE TOOL MANAGER");
        H(94,86,96,16,"SHOW YOUR SAVED RECIPES AND CHAINS");
        H(196,86,98,16,"SHOW YOUR PERSONAL PROCESS PINS");
        H(94,109,200,144,"SELECT A NUMBERED SLOT TO RENAME, UPDATE, REPLACE OR REMOVE");
        H(94,258,96,16,"SHOW THE PREVIOUS EIGHT TOOL SLOTS");
        H(196,258,98,16,"SHOW THE NEXT EIGHT TOOL SLOTS");
        H(310,178,232,16,"TYPE A NEW TOOL NAME; CTRL+A CLEARS THE FIELD");
        H(310,205,110,16,"RENAME THE SELECTED TOOL; KEEP ITS SETTINGS");
        H(430,205,110,16,"UPDATE THE SELECTED TOOL WITH CURRENT SETTINGS; KEEP ITS NAME");
        H(310,227,110,16,"REPLACE THE SLOT WITH THE WHOLE WORKING RECIPE OR CHAIN");
        H(430,227,110,16,"REMOVE THIS TOOL; KEEP AUDIO AND OTHER NUMBERED SLOTS");
        if(p->manage_action) {
            H(310,300,110,16,"CONFIRM THE DISPLAYED CHANGE TO YOUR SAVED COLLECTION");
            H(430,300,110,16,"CANCEL THIS COLLECTION CHANGE");
        }
        return "";
    }
    H(0,0,155,32,"SHOW SISTER MACHINE");
    H(165,4,54,22,"CLOSE PORTAL AND RETURN TO THE MAIN CANVAS");
    H(224,4,66,22,"SHOW SISTER MACHINE");
    H(295,4,66,22,"RELOAD THE CURRENT TILE OR CANVAS SELECTION AS PORTAL SOURCE");
    H(366,4,94,22,"SWITCH WHOLE TILE / CANVAS SELECTION AND RELOAD THE SOURCE");
    H(464,4,28,22,"START / STOP RECORDING THE FINAL MASTER OUTPUT DIRECTLY TO A WAV FILE");
    H(TS_UI_MASTER_LIMITER_X,5,28,22,"TOGGLE THE MASTER OUTPUT LIMITER");
    H(528,5,48,22,"MASTER OUTPUT GAIN; DRAG TO ADJUST THE LEVEL SENT TO THE OUTPUT");
    H(580,8,52,20,"FINAL LEFT / RIGHT OUTPUT METERS");
    H(14,62,122,16,"SEARCH NAMES, COMMANDS AND DESCRIPTIONS; CLICK TO CLEAR AND TYPE; DOWN ENTERS THE LIST");
    H(14,83,38,16,"BROWSE ALL RAW CDP PROCESSES, FACTORY INSTRUMENTS AND STARTER CHAINS");
    H(56,83,38,16,"BROWSE YOUR SAVED RECIPES AND CHAINS");
    H(98,83,38,16,"BROWSE YOUR PERSONAL PROCESS PINS");
    H(14,105,122,16,"CYCLE PROCESS FAMILIES; LEFT / RIGHT ARROWS MOVE BACK / FORWARD");
    H(14,126,122,16,"FILTER ANY / VERIFIED STEREO / MONO ONLY; COMBINES WITH SEARCH AND FAMILY");
    if(x>=14 && x<136 && y>=TS_PORTAL_LIST_Y && y<TS_PORTAL_LIST_Y+TS_PORTAL_LIST_ROWS*TS_PORTAL_LIST_ROW_H) {
        TsPortalRecipe r;
        if(ts_portal_filter(p,p->scroll+(y-TS_PORTAL_LIST_Y)/TS_PORTAL_LIST_ROW_H,&r)) {
            snprintf(text,size,"%.65s - %s",r.name,ts_portal_stereo_supported(&r)?"MONO / STEREO":"MONO ONLY");return text;
        }
    }
    H(14,334,68,16,"MANAGE SAVED RECIPES AND PINS: RENAME / UPDATE / REPLACE / REMOVE");
    H(86,334,50,16,"SAVE A PERSONAL COPY OF THE WHOLE WORKING RECIPE OR CHAIN");
    H(154,60,310,62,"SOURCE: CLICK PLAYHEAD; DRAG SELECTION; WHEEL ZOOM; SHIFT PAN; ALT RESIZE; RIGHT CLEAR");
    H(154,152,310,62,"RESULT: CLICK PLAYHEAD; DRAG SELECTION; WHEEL ZOOM; SHIFT PAN; ALT RESIZE; RIGHT CLEAR");
    H(150,223,49,16,"PLAY / STOP THE SELECTED SOURCE OR RESULT; SPACE ALSO TOGGLES PLAYBACK");
    H(203,223,62,16,"AUDITION SOURCE; ITS SELECTION IS INDEPENDENT OF THE RESULT");
    H(269,223,62,16,"AUDITION RESULT; ITS SELECTION IS INDEPENDENT OF THE SOURCE");
    H(335,223,42,16,"LOOP THE AUDITION SELECTION OR WHOLE WAVEFORM");
    H(381,223,40,16,"FIT BOTH WAVEFORMS TO THEIR FULL LENGTH");
    H(425,223,39,16,"SWITCH SOURCE / RESULT FOR COMPARISON; TAB DOES THE SAME");
    H(310,247,124,16,"PROCESS WHOLE SOURCE OR ITS SELECTION; SELECTION MODE PRESERVES SURROUNDING AUDIO");
    if(y>=265 && y<322 && x>=154 && x<460) {
        TsPortalControl control;
        if(ts_portal_control_at(p,p->parameter_scroll+(y-265)/19,&control)) {
            if(x>=440)return "EXPOSE THIS PARAMETER IN MACROS VIEW AND CHECKED-MACRO PINS";
            if(x>=388)return "CLICK FOR EXACT NUMERIC ENTRY; ENTER COMMITS; ESC CANCELS; WHEEL ADJUSTS";
            if(x>=253)return "DRAG OR WHEEL TO ADJUST THIS PARAMETER; MACROS VIEW USES YOUR CUSTOM RANGE";
            snprintf(text,size,"%.28s: %.67s",control.process->parameters[control.index].label,
                control.process->parameters[control.index].help?control.process->parameters[control.index].help:"RIGHT-CLICK TO NAME AND LIMIT THIS MACRO");return text;
        }
    }
    if(p->chain_active) {
        H(478,63,46,16,"ARM / CANCEL ADD; CHOOSE A SINGLE PROCESS TO INSERT AFTER THE SELECTED STAGE");
        H(528,63,46,16,"MOVE THE SELECTED CHAIN STAGE UP WITH ITS MACROS");
        H(578,63,48,16,"MOVE THE SELECTED CHAIN STAGE DOWN WITH ITS MACROS");
        if(y>=84 && y<84+(int)p->chain.stage_count*14) {
            H(603,84,23,112,"ENABLE / BYPASS THIS STAGE; BYPASSED STAGES DO NOT LIMIT STEREO SUPPORT");
            H(478,84,124,112,"SELECT THIS STAGE TO EDIT AND AUDITION ITS CACHED OUTPUT; APPLY USES THE FINAL CHAIN");
        }
        H(478,201,72,16,"REMOVE THE SELECTED STAGE; A CHAIN KEEPS AT LEAST ONE STAGE");
        H(554,201,72,16,"SHOW THE CHAIN DESCRIPTION IN MACROS VIEW OR THE SELECTED PROCESS IN FULL VIEW");
    }
    H(478,220,72,16,"RESTORE DEFAULT PARAMETER VALUES FOR THE SELECTED PROCESS");
    H(554,220,72,16,"SWITCH ALL ORIGINAL PARAMETERS / EXPOSED MACROS FROM EVERY CHAIN STAGE");
    H(478,242,148,16,"NAME THE WORKING RECIPE OR WHOLE CHAIN BEFORE SAVING");
    H(478,263,148,16,"PIN CHECKED MACROS FOR EDITABLE CONTROLS OR AN EXACT RECIPE WITH FIXED VALUES");
    H(478,287,22,16,"SELECT THE PREVIOUS PERSONAL PIN SLOT");
    H(604,287,22,16,"SELECT THE NEXT PERSONAL PIN SLOT");
    H(478,308,66,16,"AUTO PREVIEW: RENDER AFTER 500 MS WITHOUT FURTHER SOUND EDITS");
    H(550,308,32,16,"SUSTAIN: RELEASED NOTES FINISH; WITH LOOP ON THEY REPEAT. SHIFT+S TOGGLES");
    H(150,332,76,22,p->busy?"CANCEL THE CURRENT RENDER AND PENDING AUTO PREVIEW":"RENDER THE WORKING PROCESS OR CHAIN; ENTER ALSO PREVIEWS");
    H(230,332,64,22,"REPLACE THE ORIGINAL TILE REGION WITH THE FINAL RESULT; PROMOTE RESULT TO SOURCE");
    H(298,332,78,22,"PUT THE FINAL RESULT ON AN EMPTY TILE; KEEP THE ORIGINAL PORTAL SOURCE");
    H(380,332,84,22,"PUT THE FINAL RESULT ON AN EMPTY TILE AND CONTINUE WITH IT AS PORTAL SOURCE");
    H(478,332,148,22,"SAVE THE WHOLE WORKING RECIPE OR CHAIN IN THE SELECTED PERSONAL PIN SLOT");
    H(8,360,54,16,p->chain_active?"RETURN TO SINGLE PROCESS MODE WITH THE SELECTED STAGE":"START A CHAIN WITH THE CURRENT PROCESS AS STAGE ONE");
    if(x>=64 && x<64+p->history_count*107 && y>=360 && y<376)
        return "RECALL THIS COMPLETED RESULT AND ITS RECIPE FROM SESSION HISTORY";
    H(501,360,125,16,p->chain_active?"AUDITION THE FINAL COMPLETED CHAIN RESULT":
        ts_portal_factory_find(p->recipe.process_id)?"SAVE THIS FACTORY INSTRUMENT'S SETTINGS BACK TO ITS ORIGINAL BANK PRESET":
        "RETURN TO MAIN; CTRL+Z THERE UNDOES THE LAST TILE EDIT");
#undef H
    return "";
}
static void portal_hover_reset(TsPortalUi *p,PortalController *c)
{
    p->tooltip[0]=0;c->hover_help[0]=0;
}
static void portal_hover_poll(TsPortalUi *p,PortalController *c,int x,int y,Uint32 now,int blocked)
{
    char buffer[160];
    if(!p->open || blocked || p->busy || p->dragging_parameter>=0 || p->dragging_wave>=0) {
        portal_hover_reset(p,c);return;
    }
    const char *help=portal_hover_help(p,x,y,buffer,sizeof(buffer));
    if(strcmp(help,c->hover_help)) {
        snprintf(c->hover_help,sizeof(c->hover_help),"%s",help);
        snprintf(c->hover_status,sizeof(c->hover_status),"%s",p->message);
        c->hover_due=now+TS_PORTAL_TOOLTIP_DELAY_MS;p->tooltip[0]=0;
    } else if(strcmp(c->hover_status,p->message)) {
        /* A fresh result/error/recording message gets time in the status line. */
        snprintf(c->hover_status,sizeof(c->hover_status),"%s",p->message);
        c->hover_due=now+2400u;p->tooltip[0]=0;
    }
    if(*help && SDL_TICKS_PASSED(now,c->hover_due))
        snprintf(p->tooltip,sizeof(p->tooltip),"%s",help);
}
