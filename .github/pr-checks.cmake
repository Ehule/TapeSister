cmake_minimum_required(VERSION 3.20)
# Two columns: build target and CTest name. Some integration tests share an
# executable or use a different name. Validate every requested test before a
# successful subset could hide a typo or an unavailable feature.
get_filename_component(pr_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED PR_BUILD_DIR)
  set(PR_BUILD_DIR "${pr_root}/build-pr")
endif()
if(NOT DEFINED PR_MANIFEST)
  set(PR_MANIFEST "${CMAKE_CURRENT_LIST_DIR}/pr-regressions.txt")
endif()
file(STRINGS "${PR_MANIFEST}" pr_entries)
set(pr_targets tapesister)
set(pr_tests)
foreach(pr_entry IN LISTS pr_entries)
  if(NOT pr_entry MATCHES "^([A-Za-z0-9_-]+)[ \t]+([A-Za-z0-9_-]+)$")
    message(FATAL_ERROR "Invalid PR regression entry: ${pr_entry}")
  endif()
  list(APPEND pr_targets "${CMAKE_MATCH_1}")
  if(CMAKE_MATCH_2 IN_LIST pr_tests)
    message(FATAL_ERROR "Duplicate PR regression: ${CMAKE_MATCH_2}")
  endif()
  list(APPEND pr_tests "${CMAKE_MATCH_2}")
endforeach()
if(NOT pr_tests)
  message(FATAL_ERROR "PR regression list is empty")
endif()
get_filename_component(pr_tool_dir "${CMAKE_COMMAND}" DIRECTORY)
find_program(pr_ctest NAMES ctest HINTS "${pr_tool_dir}" REQUIRED)
execute_process(COMMAND "${pr_ctest}" --test-dir "${PR_BUILD_DIR}" --show-only=json-v1
  OUTPUT_VARIABLE pr_catalog COMMAND_ERROR_IS_FATAL ANY)
string(JSON pr_count LENGTH "${pr_catalog}" tests)
set(pr_available)
if(pr_count GREATER 0)
  math(EXPR pr_last "${pr_count}-1")
  foreach(pr_index RANGE 0 ${pr_last})
    string(JSON pr_name GET "${pr_catalog}" tests ${pr_index} name)
    list(APPEND pr_available "${pr_name}")
  endforeach()
endif()
foreach(pr_name IN LISTS pr_tests)
  if(NOT pr_name IN_LIST pr_available)
    message(FATAL_ERROR "PR regression is not registered: ${pr_name}")
  endif()
endforeach()
list(REMOVE_DUPLICATES pr_targets)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${PR_BUILD_DIR}" --parallel 2 --target ${pr_targets}
  COMMAND_ERROR_IS_FATAL ANY)
list(JOIN pr_tests "|" pr_regex)
execute_process(COMMAND "${pr_ctest}" --test-dir "${PR_BUILD_DIR}" --output-on-failure
  --no-tests=error -R "^(${pr_regex})$" COMMAND_ERROR_IS_FATAL ANY)
