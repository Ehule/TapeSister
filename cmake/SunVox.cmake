# Pinned engine sources and unmodified factory effects. All DSP is compiled
# into the application so project recall never depends on an installed SunVox.
enable_language(CXX)
set(CMAKE_CXX_STANDARD 11)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(SV_ROOT "${CMAKE_BINARY_DIR}/sunvox")
set(SV_ARCHIVE "${CMAKE_CURRENT_SOURCE_DIR}/third_party/sunvox/sunvox-2.1.4d.tar.gz")
set(SV_GENERATOR "${CMAKE_CURRENT_SOURCE_DIR}/tools/build_sunvox_catalog.py")
set(SV_PREPARE "${CMAKE_CURRENT_SOURCE_DIR}/tools/prepare_sunvox_realtime.py")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SV_ARCHIVE}" "${SV_GENERATOR}" "${SV_PREPARE}")
file(SHA256 "${SV_ARCHIVE}" SV_ARCHIVE_HASH)
if(NOT SV_ARCHIVE_HASH STREQUAL "cbe39f7fdbee6ab51ab832b7ea693d027e7d294666f397870281bc2177e71d75")
  message(FATAL_ERROR "Bundled SunVox archive does not match its pinned hash")
endif()
file(SHA256 "${SV_GENERATOR}" SV_GENERATOR_HASH)
file(SHA256 "${SV_PREPARE}" SV_PREPARE_HASH)
set(SV_STAMP "${SV_ARCHIVE_HASH}-${SV_GENERATOR_HASH}-${SV_PREPARE_HASH}")
set(SV_PREVIOUS "")
if(EXISTS "${SV_ROOT}/stamp")
  file(READ "${SV_ROOT}/stamp" SV_PREVIOUS)
endif()
if(NOT SV_PREVIOUS STREQUAL SV_STAMP OR NOT EXISTS "${CMAKE_BINARY_DIR}/sunvox_catalog.inc")
  file(MAKE_DIRECTORY "${SV_ROOT}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xzf "${SV_ARCHIVE}"
    WORKING_DIRECTORY "${SV_ROOT}" RESULT_VARIABLE SV_UNPACK)
  if(NOT SV_UNPACK EQUAL 0)
    message(FATAL_ERROR "Cannot unpack the bundled SunVox engine")
  endif()
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${SV_GENERATOR}"
    "${SV_ROOT}/effects" "${CMAKE_BINARY_DIR}/sunvox_catalog.inc" RESULT_VARIABLE SV_CATALOG)
  if(NOT SV_CATALOG EQUAL 0)
    message(FATAL_ERROR "Cannot build the SunVox effect catalog")
  endif()
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${SV_PREPARE}" "${SV_ROOT}"
    COMMAND_ERROR_IS_FATAL ANY)
  file(WRITE "${SV_ROOT}/stamp" "${SV_STAMP}")
endif()
file(GLOB SV_ENGINE "${SV_ROOT}/lib_sunvox/*.cpp" "${SV_ROOT}/lib_sunvox/psynth/*.cpp"
  "${SV_ROOT}/lib_sunvox/midi_file/*.cpp" "${SV_ROOT}/lib_sunvox/xm/*.cpp" "${SV_ROOT}/lib_dsp/*.cpp")
set(SV_SUNDOG)
foreach(component file log main memory misc net sound thread time video)
  file(GLOB SV_COMPONENT "${SV_ROOT}/lib_sundog/${component}/*.cpp")
  list(APPEND SV_SUNDOG ${SV_COMPONENT})
endforeach()
set(SV_CODEC)
foreach(name bitwise codebook dsp floor0 floor1 floor_lookup framing info mapping0 mdct misc res012 vorbisfile)
  list(APPEND SV_CODEC "${SV_ROOT}/lib_vorbis/tremor/${name}.c")
endforeach()
foreach(name bitwise framing)
  list(APPEND SV_CODEC "${SV_ROOT}/lib_vorbis/libogg/${name}.c")
endforeach()
foreach(name bitmath bitreader cpu crc fixed fixed_intrin_sse2 fixed_intrin_ssse3 fixed_intrin_sse42
    format lpc lpc_intrin_sse2 lpc_intrin_sse41 lpc_intrin_neon md5 memory stream_decoder win_utf8_io)
  list(APPEND SV_CODEC "${SV_ROOT}/lib_flac/libFLAC/${name}.c")
endforeach()
add_library(tapesister_sunvox STATIC src/ts_sunvox_fx.cpp ${SV_ENGINE} ${SV_SUNDOG} ${SV_CODEC})
set_target_properties(tapesister_sunvox PROPERTIES C_EXTENSIONS ON CXX_EXTENSIONS ON)
target_include_directories(tapesister_sunvox PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include" "${CMAKE_BINARY_DIR}" "${SV_ROOT}/lib_sundog" "${SV_ROOT}/lib_sunvox"
  "${SV_ROOT}/lib_dsp" "${SV_ROOT}/lib_mp3" "${SV_ROOT}/lib_flac/libFLAC"
  "${SV_ROOT}/lib_vorbis/tremor" "${SV_ROOT}/lib_vorbis/libogg" "${SV_ROOT}/lib_vorbis/libvorbis")
target_compile_definitions(tapesister_sunvox PRIVATE PS_STYPE_FLOAT32 COLOR32BITS
  SUNVOX_LIB NOMAIN NOGUI NOSOUND NOMIDI NOVIDEO NOVCAP NOLIST NOFILEUTILS NOIMAGEFORMATS
  NOOGGENC NOFLACENC NOLOG APPNAME="TapeSister" MIN_SAMPLE_RATE=8000)
if(WIN32)
  target_link_libraries(tapesister_sunvox PUBLIC winmm ws2_32)
else()
  find_package(Threads REQUIRED)
  target_link_libraries(tapesister_sunvox PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
endif()
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  target_compile_options(tapesister_sunvox PRIVATE -Wno-multichar -Wno-unused-result)
endif()
